RECKON_APP_NAME=Reckon SEO Autopilot API
RECKON_ENVIRONMENT=local
RECKON_DATABASE_URL=postgresql+psycopg://reckon:change-me@localhost:5432/reckon
RECKON_OIDC_ISSUER=https://identity.example.com/
RECKON_OIDC_AUDIENCE=reckon-seo-api
RECKON_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
RECKON_CRAWL_DAILY_LIMIT=10
RECKON_CRAWL_HISTORY_RETENTION_DAYS=365
# Opt-in Redis/Celery crawl execution. Leave disabled for synchronous bounded crawls.
# RECKON_CRAWL_WORKER_ENABLED=true
# RECKON_CRAWL_BROKER_URL=redis://127.0.0.1:6379/0
# Per-organization AI test token budget; unknown outcomes remain reserved across days.
RECKON_AI_TEST_DAILY_TOKEN_LIMIT=10000
# Generate a unique base64-encoded 32-byte key locally; keep it outside version control.
# Never change or lose this key without a credential re-encryption plan.
RECKON_CREDENTIAL_ENCRYPTION_KEY=

# Native accounts are disabled until explicitly enabled. Public signup and recovery require TLS SMTP.
# RECKON_NATIVE_AUTH_ENABLED=true
# RECKON_SMTP_HOST=smtp.example.com
# RECKON_SMTP_PORT=587
# RECKON_SMTP_TLS=starttls
# RECKON_SMTP_FROM=accounts@example.com
# RECKON_SMTP_USERNAME=
# RECKON_SMTP_PASSWORD=
# RECKON_WEB_PUBLIC_ORIGIN=http://127.0.0.1:5173

# Opt-in local WordPress discovery only. Writes remain disabled and require approval.
# RECKON_CMS_WORDPRESS_ENABLED=true
# RECKON_CMS_WORDPRESS_BASE_URL=https://wordpress.example.com
# RECKON_CMS_WORDPRESS_USERNAME=
# RECKON_CMS_WORDPRESS_APP_PASSWORD=

# Public browser-client settings; configure these with the same OIDC issuer.
# The client ID is public. Never put a client secret or API credential in a VITE_ variable.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_RESOURCE=
VITE_OIDC_SCOPE=openid profile

# Informational project metadata; these are not runtime settings.
# Project author: Reckon Technologies Ltd.
# Project license: Proprietary (All Rights Reserved)
