RECKON_APP_NAME=Reckon SEO Autopilot API
RECKON_ENVIRONMENT=local
RECKON_DATABASE_URL=postgresql+psycopg://reckon:change-me@localhost:5432/reckon
RECKON_OIDC_ISSUER=https://identity.example.com/
RECKON_OIDC_AUDIENCE=reckon-seo-api
RECKON_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
RECKON_CRAWL_DAILY_LIMIT=10

# Public browser-client settings; configure these with the same OIDC issuer.
# The client ID is public. Never put a client secret or API credential in a VITE_ variable.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_RESOURCE=
VITE_OIDC_SCOPE=openid profile

